# Solo NOMBRES de variables. Nunca valores reales.
# Desarrollo: copiar a .env (no versionado). Producción: mecanismo de secretos pendiente (Fase 4, Railway).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DATABASE_URL=

# Identidad (Fase 1B): implementación del IdentityVerifier y allowlist de emails del owner.
# Desarrollo/tests: identity.verifier.FakeVerifier. Producción: se decide en la Fase 6.
JARVIS_IDENTITY_VERIFIER=
JARVIS_OWNER_EMAILS=

# IA (Fase 1B): proveedor y modelos por rol. Solo "fake" hasta la Fase 3 (ADR-005).
JARVIS_LLM_PROVIDER=
JARVIS_LLM_MODEL_CHEAP=
JARVIS_LLM_MODEL_CODING=
JARVIS_LLM_MODEL_REASONING=

# Anthropic (Fase 3b, ADR-005 opción A): la clave vive solo en el control plane; el sandbox llega al
# proxy /llm a través de un reenviador en JARVIS_LLM_PROXY_TARGET (host:port visto desde Docker).
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=        # alternativa: ruta a un archivo fuera del repo con la clave
ANTHROPIC_API_URL=
JARVIS_LLM_PROXY_TARGET=

# Cola de tareas (Fase 4, ADR-003): inprocess | postgres. Agente de los jobs: auto | mock | claude_code.
JARVIS_TASK_QUEUE=
JARVIS_CODER_AGENT=

# Coding worker (Fase 3): docker | inprocess (solo tests), imagen del sandbox y raíz de workspaces.
JARVIS_WORKER_EXECUTOR=
JARVIS_WORKER_IMAGE=
JARVIS_WORKSPACE_ROOT=

# Catálogo de precios versionado (por defecto pricing/pricing.yaml).
JARVIS_PRICING_FILE=

FIREBASE_PROJECT_ID=
OWNER_FIREBASE_UID=

# GitHub App privada (Fase 2). JARVIS_REPO_HOST: fake | github.
JARVIS_REPO_HOST=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=     # alternativa: ruta al .pem fuera del repositorio
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
